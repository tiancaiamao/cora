(import "cora/lib/infer")
(import "cora/lib/cml")
(import "cora/lib/chan")
(import "cora/lib/async")
(import "cora/lib/net")

;; Static shape checks over existing module APIs (no runtime side effects).
(check-type! '(cora/lib/cml#spawn (lambda () 1)) (tvar))
(check-type! '(chan-make) (tvar))
(check-type! '(async-dial "127.0.0.1:8080") (tvar))
(check-type! '(async-listen "127.0.0.1:8080") (tvar))
(check-type! '(cora/lib/net#net-dial "127.0.0.1:8080") (tvar))
(check-type! '(cora/lib/net#net-listen "127.0.0.1:8080") (tvar))
(check-type! '(cora/lib/net#make-bytes 16) 'string)
(check-type! '(cora/lib/net#bytes-substring "abcd" 0 2) 'string)
