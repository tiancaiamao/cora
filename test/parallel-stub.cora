(package "cora/test/parallel-stub"
  (import "cora/lib/parallel")
  (import "cora/lib/io")

  (defun test-basic ()
    (begin
      (display "Testing parallel runtime stub...\n")
      (display "Init runtime with 2 threads\n")
      (parallel-init 2)
      (display "Init completed\n")
      (display "Current VM: ")
      (display (vm-get-current-id))
      (display "\n")
      (display "Shutdown\n")
      (parallel-shutdown)
      (display "Test completed\n")))
