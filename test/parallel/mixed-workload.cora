;; Mixed workload smoke test.

(import "cora/lib/io")
(import "cora/lib/cml")
(import "cora/lib/parallel")

(defun fib (n)
  (if (< n 2)
      n
      (+ (fib (- n 1)) (fib (- n 2)))))

(defun cpu-worker (id n)
  (if (= n 0)
      (begin
        (display "CPU worker ")
        (display id)
        (display " done\n"))
      (begin
        (display "CPU worker ")
        (display id)
        (display " fib= ")
        (display (fib 20))
        (display "\n")
        (yield)
        (cpu-worker id (- n 1)))))

(defun io-worker (id n)
  (if (= n 0)
      (begin
        (display "IO worker ")
        (display id)
        (display " done\n"))
      (begin
        (display "IO worker ")
        (display id)
        (display " tick\n")
        (yield)
        (yield)
        (io-worker id (- n 1)))))

(defun main ()
  (display "Mixed Workload Test\n")
  (spawn (lambda () (cpu-worker 1 3)))
  (spawn (lambda () (cpu-worker 2 3)))
  (spawn (lambda () (io-worker 1 5)))
  (spawn (lambda () (io-worker 2 5)))
  (spawn (lambda () (io-worker 3 5))))

(parallel-entry main 4)
