(import "cora/lib/io")
(import "cora/lib/async")
(import "cora/lib/cml")
(import "cora/lib/parallel")

(defun client ()
  (let mb (mailbox-resolve "test")
    (client-h 99 mb)))

(defun client-h (i mb)
  (if (= i 0)
      ()
      (begin
       (mailbox/send! mb i)
       (display "send a ping\n")
       (client-h (- i 1) mb))))

(defun main ()
  (let mb (mailbox-make)
    (begin
      (mailbox-publish "test" mb)
      (spawn-vm "test/parallel/recv.cora")
      (client))))

(parallel-entry main 2)
