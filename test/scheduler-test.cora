;; Test VM scheduler with coroutines

(import "cora/lib/parallel")
(import "cora/lib/io")

(defun main ()
  (begin
    (display "=== Testing VM Scheduler ===\n")
    (display "Spawning VM with worker entry...\n")
    (let vm-id (spawn-vm "test/parallel/worker.cora")
      (begin
        (display "VM ID: ")
        (display vm-id)
        (display "\n")
        (display "=== Test Complete ===\n")))))

(parallel-entry main 2)
