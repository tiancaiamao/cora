(package "cora/test/test-net-only"
  (import "cora/lib/parallel/internal")

  (defun main ()
    (begin
      (display "Calling net-listen...\n")
      (let fd (net-listen nil 9997)
        (begin
          (display "fd = ")
          (display fd)
          (display "\n")
          (if (or (> fd 0) (= fd 0))
              (begin
                (display "SUCCESS\n")
                (net-close fd))
              (display "FAILED\n"))))
      (display "Done\n")))

  (main)
  )
