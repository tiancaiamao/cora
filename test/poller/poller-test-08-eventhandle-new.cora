;; Poller test 08: EventHandle creation smoke test.
;; Use fd = -1 to avoid depending on real sockets in this unit case.

(import "cora/lib/io")
(import "cora/lib/poller/internal")

(let eh (cora/lib/poller/internal#event-handle-new -1)
  (begin
    (display "event-handle-new result: ")
    (display eh)
    (display "\n")
    (display "poller event handle smoke ok\n")))
