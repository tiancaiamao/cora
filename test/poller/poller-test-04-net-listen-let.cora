;; Poller 测试 04: 在 let 中绑定 net-listen 的返回值
;; 预期结果: ✅ 应该成功
;; 状态: ✅ 通过 - 修复语法错误后可以正常工作
;; 修复说明:
;;   1. 添加了 (import "cora/lib/io") 以使用 display
;;   2. 修复了 let 语法：从 (let fd (net-listen ...)) 改为 (let fd (net-listen ...)

(import "cora/lib/io")
(import "cora/lib/net/internal")

(display "=== 测试 04: let + net-listen ===\n")
(display "创建监听 socket...\n")

(let fd (net-listen "0.0.0.0" 9979)
  (begin
    (display "fd=")
    (display fd)
    (display "\n")
    (net-close fd)
    (display "测试完成!\n")
    42))
