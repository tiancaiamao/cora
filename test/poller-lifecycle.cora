;; Simple poller thread test

(display "Loading parallel module...\n")
(import "cora/lib/parallel/internal")

(display "Test 1: Initialize poller...\n")
(let result (cora/lib/parallel/internal#poller-init)
  (begin
    (display "Init result: ")
    (display result)
    (display "\n")
    
    (display "Test 2: Shutdown poller...\n")
    (let shutdown (cora/lib/parallel/internal#poller-shutdown)
      (begin
        (display "Shutdown result: ")
        (display shutdown)
        (display "\n")
        (display "Done!\n")
        0))))
