;; Simple test - just check if bytes work

(import "cora/lib/http/internal")

(display "Testing bytes...\n")

(let s "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
  (begin
    (display "String created\n")
    (let b (string->bytes s)
      (begin
        (display "Bytes created\n")
        (display "Length: ")
        (display (bytes-length b))
        (newline)
        (display "Calling parse...\n")))))