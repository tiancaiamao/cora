;; Test HTTP request parsing

(import "cora/lib/net/http/internal")

(display "=== Test HTTP Parser ===\n\n")

;; Test 1: Simple GET request
(display "Test 1: Simple GET request\n")
(let req1 "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"
  (let result1 (http-internal-parse-request req1)
    (begin
      (display "Result: ")
      (display result1)
      (display "\n\n"))))

;; Test 2: GET with query string
(display "Test 2: GET with query string\n")
(let req2 "GET /search?q=hello&page=1 HTTP/1.1\r\nHost: example.com\r\n\r\n"
  (let result2 (http-internal-parse-request req2)
    (begin
      (display "Result: ")
      (display result2)
      (display "\n\n"))))

;; Test 3: POST request
(display "Test 3: POST request\n")
(let req3 "POST /api/users HTTP/1.1\r\nHost: api.example.com\r\nContent-Type: application/json\r\nContent-Length: 25\r\n\r\n{\"name\":\"Alice\",\"age\":30}"
  (let result3 (http-internal-parse-request req3)
    (begin
      (display "Result: ")
      (display result3)
      (display "\n\n"))))

(display "=== All tests completed ===\n")