;; Simple test of high-level API

(display "Loading parallel module...\n")
(import "cora/lib/parallel")

(display "Test: parallel/init\n")
(parallel/init 2)
(display "Runtime initialized!\n")

(display "Test: mailbox/new\n")
(let mb (mailbox/new 5)
  (begin
    (display "Mailbox created\n")
    
    (display "Test: mailbox/send!\n")
    (mailbox/send! mb 42)
    (display "Sent 42\n")
    
    (display "Test: mailbox/recv\n")
    (let val (mailbox/recv mb)
      (begin
        (display "Received: ")
        (display val)
        (display "\n")
        
        (display "Test: parallel/shutdown\n")
        (parallel/shutdown)
        (display "Done!\n")
        0))))
