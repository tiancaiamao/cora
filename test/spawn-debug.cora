;; Minimal spawn test with debug output

(display "Step 1: Before import\n")
(import "cora/lib/parallel/internal")
(display "Step 2: After import\n")

(display "Step 3: Before init\n")
(cora/lib/parallel/internal#vm-runtime-init 2)
(display "Step 4: After init\n")

(display "Step 5: Before spawn-vm-native call\n")
(let vm-id (cora/lib/parallel/internal#spawn-vm-native (lambda () (display "In VM!\n")))
  (begin
    (display "Step 6: After spawn-vm-native, VM ID: ")
    (display vm-id)
    (display "\n")
    
    (display "Step 7: Before shutdown\n")
    (cora/lib/parallel/internal#vm-runtime-shutdown)
    (display "Step 8: After shutdown\n")))
