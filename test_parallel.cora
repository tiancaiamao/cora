;; Test the new parallel mode implementation
;; This test should work with the refactored CML and scheduler

(import "cora/lib/parallel")
(import "cora/lib/io")
(import "cora/lib/cml")

;; Test 1: Single VM mode (backward compatible)
(display "=== Test 1: Single VM mode ===\n")

(let task (lambda ()
    (begin
        (display "  Task started\n")
        (cora/lib/cml#yield)
        (display "  Task resumed after yield\n")
        42))
(cora/lib/cml#cml-entry task))

(display "Test 1 completed\n\n")

;; Test 2: Parallel mode (new)
(display "=== Test 2: Parallel mode ===\n")

;; Re-initialize (need to reset for second test)
; (load "lib/parallel.cora")

;; Initialize runtime with 2 worker threads
(display "  Initializing runtime with 2 threads...\n")
(parallel-init 2)

; (display "  Runtime initialized\n")

; ;; Create a simple task that uses spawn and yield
; (let task (lambda ()
;     (display "  Task started in parallel mode\n")
;     ;; Note: In parallel mode, we don't have yield yet
;     ;; But we can test that the task runs
;     42))

; ;; Spawn the task using parallel mode
; (display "  Spawning task in parallel mode...\n")
(spawn-vm "test.cora")

;; Briefly run scheduler
;; In a real test, we'd wait for VM completion
(display "  Test 2 initialized (VM should execute in worker threads)\n")

; ;; Shutdown
(parallel-shutdown)
(display "Test 2 completed\n")
