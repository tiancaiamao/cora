;; Test handle-map implementation

(load "cora/lib/cml")
(display "=== Handle Map Test ===\n")

;; Test 1: Basic add and get
(let hmap (handle-map-create))
  (let socket (make-vector 100))
    (let handle (handle-map-add hmap socket))
      (let retrieved (handle-map-get hmap handle))
        (display "Test 1: Add socket and retrieve\n")
        (if (= retrieved socket)
            (display "  ✓ Retrieved same socket\n")
            (display "  ✗ Retrieved different object\n"))
      
      ;; Test invalid handle
      (let invalid-handle (handle-map-get hmap 999))
        (if (= invalid-handle ())
            (display "Test 2: Invalid handle returns Nil\n")
            (display "  ✓ Pass\n")
            (display "  ✗ Fail\n")))))
  
  ;; Test 2: Add multiple resources
  (let hmap2 (handle-map-create 16))
    (dotimes (i 10)
      (let res (make-vector 50 i))
        (let handle (handle-map-add hmap2 res))
          ;; Just store handles
          (let _ (handle-map-get hmap2 handle) 'ignore)))
    (display "Test 2: Added 10 resources\n")
  
  ;; Test 3: Delete and reuse
  (let hmap3 (handle-map-create))
    (let res1 (make-vector 100 1))
    (let res2 (make-vector 100 2))
      (let handle1 (handle-map-add hmap3 res1))
      (let handle2 (handle-map-add hmap3 res2))
        (display "Test 3: Added 2 resources\n")
        
        ;; Delete first resource
        (let deleted1 (handle-map-delete hmap3 handle1))
          (if (= deleted1 res1)
              (display "  ✓ Delete returns correct resource\n")
              (display "  ✗ Delete returns wrong resource\n"))
        
        ;; Test reuse (free stack should reuse handle1)
        (dotimes (i 5)
          (let res3 (make-vector 100 (+ i 10)))
            (let handle3 (handle-map-add hmap3 res3))
              (let _ (handle-map-get hmap3 handle3) 'ignore))))
        
        (display "Test 3: Added 5 more resources (check free stack reuse)\n")
        
        ;; Test that handle1 was reused
        (let reuse-test (handle-map-get hmap3 handle1))
          (if (= reuse-test res3)
              (display "  ✓ Free stack was reused correctly\n")
              (display "  ✗ Free stack NOT reused\n")))))

  ;; Test 4: Expansion
  (let hmap4 (handle-map-create))
    (dotimes (i 20)
      (let res (make-vector 100 i))
        (let _ (handle-map-add hmap4 res) 'ignore)))
    (display "Test 4: Expansion test (20 resources)\n")
    
    ;; Check final capacity
    (let resources (cora/lib/define-record#handle-map-resources hmap4))
    (display (format "Final capacity: ~a~n" (vector-length resources)))

(display "\n=== All tests completed ===\n")
