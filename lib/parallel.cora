;; Parallel execution runtime for Cora
;; Provides multi-VM execution with M:N threading

(package "cora/lib/parallel"
  (import "cora/lib/parallel/internal")
  (import "cora/lib/queue")
  (import "cora/lib/io")
  (import "cora/lib/sys")
  (import "cora/lib/cml")
  (export 
    ;; Runtime management
    parallel-init parallel-shutdown
    ;; VM management  
    vm-current-id
    ;; Task spawning
    spawn spawn-vm
    ;; Entry point
    parallel-entry)

  ;; Initialize parallel runtime
  (defun parallel-init (num-threads)
    (vm-runtime-init num-threads))

  ;; Shutdown parallel runtime
  (defun parallel-shutdown ()
    (vm-runtime-shutdown))

  ;; Get current VM ID
  (defun vm-current-id ()
    (vm-get-current-id))

  ;; Spawn coroutine in current VM
  ;; This extends the existing CML spawn to work with parallel runtime
  (defun spawn (thunk)
    (let current-vm (vm-get-current)
         (if current-vm
             ;; We're in a parallel VM, use CML's spawn
             (cora/lib/cml#spawn thunk)
             ;; We're not in parallel mode, fall back to regular CML
             (cora/lib/cml#spawn thunk))))

  ;; Spawn coroutine in a new VM
  (defun spawn-vm (thunk)
    (let vm-id (spawn-vm-native thunk)
         vm-id))

  ;; Parallel entry point
  ;; Similar to cml-entry but for multi-VM execution
  (defun parallel-entry (main num-threads)
    (begin
      ;; Initialize parallel runtime
      (parallel-init num-threads)
      
      ;; Create initial VM and run main
      (let initial-vm-id (spawn-vm main)
           (begin
             (display "Parallel runtime started with ")
             (display num-threads)
             (display " threads\n")
             
             ;; Wait for all VMs to complete
             ;; This is a simplified version - in reality we'd need
             ;; a more sophisticated way to wait for completion
             (vm-runtime-wait-all)
             
             (display "All VMs completed\n")
             
             ;; Shutdown runtime
             (parallel-shutdown)))))

  ;; Internal functions implemented in C
  ;; These functions are registered by register_parallel_runtime()
  
  ;; Note: The actual implementations are in lib/parallel/cora-bindings.c
  ;; and are registered when the parallel runtime is loaded
  )
