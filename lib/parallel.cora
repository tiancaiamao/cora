;; Parallel execution runtime for Cora
;; Provides multi-VM execution with M:N threading

(package "cora/lib/parallel"
  (import "cora/lib/parallel/internal")
  (import "cora/lib/queue")
  (import "cora/lib/io")
  (import "cora/lib/sys")
  (import "cora/lib/cml")
  (export 
    ;; Runtime management
    parallel-init parallel-shutdown
    vm-runtime-init vm-runtime-shutdown vm-runtime-wait-all
    ;; VM management  
    vm-current-id vm-get-current vm-get-current-id
    ;; Task spawning
    spawn spawn-vm spawn-vm-native
    ;; Mailbox API
    mailbox-new mailbox-close mailbox-is-closed
    mailbox-send-try mailbox-recv-try
    mailbox-publish mailbox-resolve
    ;; Entry point
    parallel-entry)

  ;; Initialize parallel runtime
  (defun parallel-init (num-threads)
    (cora/lib/parallel/internal#vm-runtime-init num-threads))

  ;; Shutdown parallel runtime
  (defun parallel-shutdown ()
    (cora/lib/parallel/internal#vm-runtime-shutdown))

  ;; Direct access to internal functions for advanced usage
  (defun vm-runtime-init (num-threads)
    (cora/lib/parallel/internal#vm-runtime-init num-threads))

  (defun vm-runtime-shutdown ()
    (cora/lib/parallel/internal#vm-runtime-shutdown))

  (defun vm-runtime-wait-all ()
    (cora/lib/parallel/internal#vm-runtime-wait-all))

  (defun vm-get-current ()
    (cora/lib/parallel/internal#vm-get-current))

  ;; Get current VM ID
  (defun vm-current-id ()
    (cora/lib/parallel/internal#vm-get-current-id))

  (defun vm-get-current-id ()
    (cora/lib/parallel/internal#vm-get-current-id))

  (defun spawn-vm-native (thunk)
    (cora/lib/parallel/internal#spawn-vm-native thunk))

  ;; Mailbox API wrappers
  (defun mailbox-new (capacity)
    (cora/lib/parallel/internal#mailbox-new capacity))

  (defun mailbox-close (mailbox)
    (cora/lib/parallel/internal#mailbox-close mailbox))

  (defun mailbox-is-closed (mailbox)
    (cora/lib/parallel/internal#mailbox-is-closed mailbox))

  (defun mailbox-send-try (mailbox msg)
    (cora/lib/parallel/internal#mailbox-send-try mailbox msg))

  (defun mailbox-recv-try (mailbox)
    (cora/lib/parallel/internal#mailbox-recv-try mailbox))

  (defun mailbox-publish (name mailbox)
    (cora/lib/parallel/internal#mailbox-publish name mailbox))

  (defun mailbox-resolve (name)
    (cora/lib/parallel/internal#mailbox-resolve name))

  ;; Spawn coroutine in current VM
  ;; This extends the existing CML spawn to work with parallel runtime
  (defun spawn (thunk)
    (let current-vm (vm-get-current)
         (if current-vm
             ;; We're in a parallel VM, use CML's spawn
             (cora/lib/cml#spawn thunk)
             ;; We're not in parallel mode, fall back to regular CML
             (cora/lib/cml#spawn thunk))))

  ;; Spawn coroutine in a new VM
  (defun spawn-vm (thunk)
    (let vm-id (spawn-vm-native thunk)
         vm-id))

  ;; Parallel entry point
  ;; Similar to cml-entry but for multi-VM execution
  (defun parallel-entry (main num-threads)
    (begin
      ;; Initialize parallel runtime
      (parallel-init num-threads)
      
      ;; Create initial VM and run main
      (let initial-vm-id (spawn-vm main)
           (begin
             (display "Parallel runtime started with ")
             (display num-threads)
             (display " threads\n")
             
             ;; Wait for all VMs to complete
             ;; This is a simplified version - in reality we'd need
             ;; a more sophisticated way to wait for completion
             (vm-runtime-wait-all)
             
             (display "All VMs completed\n")
             
             ;; Shutdown runtime
             (parallel-shutdown)))))

  ;; Internal functions implemented in C
  ;; These functions are registered by register_parallel_runtime()
  
  ;; Note: The actual implementations are in lib/parallel/cora-bindings.c
  ;; and are registered when the parallel runtime is loaded
  )
