(package "cora/lib/handle-map"

    (import "cora/lib/infer")
    (import "cora/lib/define-record")
    (import "cora/lib/stack")
    (import "cora/lib/io")

    (export
        handle-map-create
        handle-map-add
        handle-map-get
        handle-map-delete
        handle-map-size)

    ;; Type declarations live with module implementation.
    (declare 'handle-map-create
                            ['-> (tvar)])
    (declare 'cora/lib/handle-map#handle-map-create
                            ['-> (tvar)])
    (declare 'handle-map-add
                            [(tvar) '-> [(tvar) '-> 'int]])
    (declare 'cora/lib/handle-map#handle-map-add
                            [(tvar) '-> [(tvar) '-> 'int]])
    (declare 'handle-map-get
                            [(tvar) '-> ['int '-> (tvar)]])
    (declare 'cora/lib/handle-map#handle-map-get
                            [(tvar) '-> ['int '-> (tvar)]])
    (declare 'handle-map-delete
                            [(tvar) '-> ['int '-> (tvar)]])
    (declare 'cora/lib/handle-map#handle-map-delete
                            [(tvar) '-> ['int '-> (tvar)]])
    (declare 'handle-map-size
                            [(tvar) '-> 'int])
    (declare 'cora/lib/handle-map#handle-map-size
                            [(tvar) '-> 'int])

    (define-record <handle-map>
        (make-handle-map)
        handle-map?
        (resource handle-map->resource handle-map-resource-set!)
        (free-slots handle-map->free-slots handle-map-free-slots-set!)
        (size handle-map->size handle-map-size-set!))

    (defun handle-map-create ()
        (let hm (make-handle-map)
            (begin
                (handle-map-free-slots-set! hm (stack-create))
                (handle-map-resource-set! hm (stack-create))
                (handle-map-size-set! hm 0)
                hm)))

    (defun handle-map-add (hm val)
        (if (handle-map? hm)
            (if (= val ())
                -1
                (let resource (handle-map->resource hm)
                    free-slots (handle-map->free-slots hm)
                    reused-handle (stack-pop! free-slots)
                    (let handle (if (= reused-handle ())
                                    (stack-push! resource val)
                                    (if (number? reused-handle)
                                        (let arr (stack->data resource)
                                            cap (if (vector? arr) (vector-length arr) 0)
                                            (if (or (< reused-handle 0) (> reused-handle cap) (= reused-handle cap))
                                                (stack-push! resource val)
                                                (begin
                                                    (vector-set! arr reused-handle val)
                                                    reused-handle)))
                                        (stack-push! resource val)))
                        (begin
                            (if (not (< handle 0))
                                (handle-map-size-set! hm (+ (handle-map->size hm) 1))
                                ())
                            handle))))
            -1))

    (defun handle-map-get (hm handle)
        (if (and (handle-map? hm) (number? handle))
            (let resource (handle-map->resource hm)
                arr (stack->data resource)
                cap (if (vector? arr) (vector-length arr) 0)
                (if (or (< handle 0) (> handle cap) (= handle cap))
                    ()
                    (vector-ref arr handle)))
            ()))

    (defun handle-map-delete (hm handle)
        (if (and (handle-map? hm) (number? handle))
            (let resource (handle-map->resource hm)
                free-slots (handle-map->free-slots hm)
                arr (stack->data resource)
                cap (if (vector? arr) (vector-length arr) 0)
                (if (or (< handle 0) (> handle cap) (= handle cap))
                    ()
                    (let item (vector-ref arr handle)
                        (if (= item ())
                            ()
                            (begin
                                (vector-set! arr handle ())
                                (stack-push! free-slots handle)
                                (if (> (handle-map->size hm) 0)
                                    (handle-map-size-set! hm (- (handle-map->size hm) 1))
                                    ()))))))
            ()))

    (defun handle-map-size (hm)
        (if (handle-map? hm)
            (handle-map->size hm)
            0))
    )
