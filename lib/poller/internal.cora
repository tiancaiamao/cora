(package "cora/lib/poller/internal"
    (import "cora/lib/parallel/internal")

    (export
        poller-init
        poller-shutdown
        event-handle-new
        event-handle-enable-read
        event-handle-enable-write
        event-handle-disable-all
        event-handle-set-wakeup-info
        poller-add-handle
        poller-update-handle
        poller-remove-handle
        poller-poll
        vm-self)

    (defun poller-init ()
        (cora/lib/parallel/internal#poller-init))

    (defun poller-shutdown ()
        (cora/lib/parallel/internal#poller-shutdown))

    (defun event-handle-new (fd)
        (cora/lib/parallel/internal#event-handle-new fd))

    (defun event-handle-enable-read (eh)
        (cora/lib/parallel/internal#event-handle-enable-read eh))

    (defun event-handle-enable-write (eh)
        (cora/lib/parallel/internal#event-handle-enable-write eh))

    (defun event-handle-disable-all (eh)
        (cora/lib/parallel/internal#event-handle-disable-all eh))

    (defun event-handle-set-wakeup-info (eh vm handle)
        (cora/lib/parallel/internal#event-handle-set-wakeup-info eh vm handle))

    (defun poller-add-handle (eh)
        (cora/lib/parallel/internal#poller-add-handle eh))

    (defun poller-update-handle (eh)
        (cora/lib/parallel/internal#poller-update-handle eh))

    (defun poller-remove-handle (eh)
        (cora/lib/parallel/internal#poller-remove-handle eh))

    (defun poller-poll (timeout-ms)
        (cora/lib/parallel/internal#poller-poll timeout-ms))

    (defun vm-self ()
        (cora/lib/parallel/internal#vm-self))
    )
