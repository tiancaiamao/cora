;; concurrent ml
;; ref https://wingolog.org/archives/2018/05/16/lightweight-concurrency-in-lua
;; https://wingolog.org/archives/2017/06/29/a-new-concurrent-ml
;; "Toward a parallel implementation of Concurrent ML"    John Reppy
;; "Parallel Concurrent ML"          John Reppy

(package "cora/lib/cml"
  (import "cora/lib/queue")
  (import "cora/lib/rand")
  (import "cora/lib/sys")
  (import "cora/lib/io")
  (import "cora/lib/poller/internal")
  (import "cora/lib/handle-map")

  (export cml-entry cml-entry-init perform spawn yield wrap schedule schedule-once
      enqueue-task add-task-to-blocked cancel-blocked-handle cml-active?)

  (def *blocked-coroutine* (handle-map-create))
  (def *blocked-count* 0)

  (defun blocked-state-init ()
    (begin
      (def *blocked-coroutine* (handle-map-create))
      (def *blocked-count* 0)))

  (defun resume-handle (handle value)
        (let k (handle-map-get *blocked-coroutine* handle)
            (if (null? k)
                ()
                (begin
                    (handle-map-delete *blocked-coroutine* handle)
                    (if (> *blocked-count* 0)
                        (def *blocked-count* (- *blocked-count* 1))
                        ())
                    (enqueue-task (lambda () (k value)))))))

  (defun add-task-to-blocked (resume)
      (let handle (handle-map-add *blocked-coroutine* resume)
        (begin
          (if (= handle -1)
              ()
              (def *blocked-count* (+ *blocked-count* 1)))
          handle)))

  (defun cancel-blocked-handle (handle)
    (let k (handle-map-get *blocked-coroutine* handle)
      (if (null? k)
          false
          (begin
            (handle-map-delete *blocked-coroutine* handle)
            (if (> *blocked-count* 0)
                (def *blocked-count* (- *blocked-count* 1))
                ())
            true))))

  ;; Global task queue (VM-local, not thread-local for parallel mode)
  (def *task-queue* ())

  (defun task-queue ()
    *task-queue*)

  (defun cml-active? ()
    (not (null? *task-queue*)))

  (defun task-queue-init ()
    (def *task-queue* (queue-make)))

  ;; enqueue-task enqueue a task
  (defun enqueue-task (thunk)
    (enqueue *task-queue* thunk))

  ;; spawn wrap thunk in a resumble env and enqueue to task queue
  (defun spawn (thunk)
    (enqueue-task (lambda ()
		    (try thunk
			 (lambda (v k)
			   (v k))))))

  ;; schedule take a task out and execute it
  ;; this is the core scheduling logic, used by both schedule-once and schedule-loop
  (defun schedule ()
      (begin
          (if (queue-empty? *task-queue*)
              ()
              (let task (dequeue *task-queue*)
                  (begin
                      (task))))))

  ;; schedule-once: run one scheduling iteration and return
  ;; this is used by parallel framework (C layer drives the scheduling)
  (defun schedule-once ()
      (schedule))

  ;; schedule-loop: keep scheduling until no more tasks
  ;; this is used by single-VM mode (internal loop)
  (defun pump-poller-once (timeout-ms)
    (if (member "cora/lib/async" cora/init#*imported*)
        (let handles (cora/lib/poller/internal#poller-poll-wakeup-handles timeout-ms)
          (if (= handles false)
              ()
              (for-each (lambda (handle)
                          (resume-handle handle true))
                        handles)))
        ()))

  (defun schedule-loop ()
      (begin
          (schedule)
          (if (queue-empty? *task-queue*)
              (if (> *blocked-count* 0)
                  (begin
                    (pump-poller-once 50)
                    (schedule-loop))
                  ())
              (begin
                (pump-poller-once 0)
                (schedule-loop)))))

  ;; cml-entry: entry point for single-VM mode
  ;; Initializes CML and enters the scheduling loop
  ;; Usage: (cora/lib/cml#cml-entry (lambda () (main-body)))
  (defun cml-entry (main)
    (begin
     (blocked-state-init)
     (task-queue-init)

     (if (member "cora/lib/async" cora/init#*imported*)
         (cora/lib/poller/internal#poller-init)
         42)

     (display "cml-entry init done\n")

     (spawn main)
     (schedule-loop)))

  ;; cml-entry-init: parallel mode entry point
  ;; This initializes CML but does NOT enter the scheduling loop
  ;; The C layer (parallel framework) will drive scheduling by calling schedule-once
  ;; Usage: (cora/lib/cml#cml-entry-init (lambda () (main-body)))
  (defun cml-entry-init (main)
    (begin
     (blocked-state-init)
     (task-queue-init)

     (if (member "cora/lib/async" cora/init#*imported*)
         (cora/lib/poller/internal#poller-init)
         42)

     (display "cml-entry-init done (parallel mode)\n")
     (spawn main)))

  ;; yield: voluntarily give up control and allow other tasks to run
  ;; This captures the current continuation and re-queues it
  (defun yield ()
    (throw (lambda (k)
	     (begin
	       (enqueue *task-queue* (lambda () (k ())))))))


  (defun default-wrap (x) x)

  ;; wrap an operation to get another operation.
  ;; fn receive the value of the operation.
  (func wrap
	[try block wrap] fn => [try block (lambda (v) (fn (wrap v)))])

  (func choice-ops-try
	[] => false
	[[try1 block1 wrap1] . remain] => (match (try1)
					    false (choice-ops-try remain)
					    v (wrap1 v)))

  (defun choice-op (ops)
    (let try (lambda () (choice-ops-try ops))
      block (lambda (k wrap)
	      (for-each (lambda (op)
			  (match op
			    [try1 block1 wrap1]
			    (block1 k (lambda (v)
					(wrap (wrap1 v))))))
			ops))
      [try block default-wrap]))

  (func random-split
	[] to1 to2 => (cons to1 to2)
	[hd . tl] to1 to2 => (if (= (randN 2) 0)
				 (random-split tl (cons hd to1) to2)
				 (random-split tl to1 (cons hd to2))))

  (func random-merge
	[] from to => (append from to)
	from [] to => (append from to)
	from1 from2 to => (if (= (randN 2) 0)
			      (random-merge (cdr from1) from2 (cons (car from1) to))
			      (random-merge from1 (cdr from2) (cons (car from2) to))))

  (func shuffle-h
	l 0 => l
	l n => (let tmp (random-split l [] [])
		 (let res (random-merge (car tmp) (cdr tmp) [])
		   (shuffle-h res (- n 1)))))

  (defun shuffle (arr)
    (shuffle-h arr (/ (+ 1 (length arr)) 2)))

  (defmacro choice (input)
    ['cora/lib/cml#choice-op ['cora/lib/cml#shuffle (cons 'list (cdr input))]])

  ;; ;; perform performs an operation.
  ;; ;; an operation consistent of [try block wrap]
  ;; ;; Usage example:
  ;; ;; (perform (choice
  ;; ;; 	  (wrap (recv ch1)
  ;; ;; 		   (lambda (v) ...))
  ;; ;; 	  (wrap (send ch2)
  ;; ;; 		   (lambda (v) ...))))
  (defun perform (op)
    (let try (car op)
	 block (cadr op)
	 wrap (caddr op)
	 (let v (try)
	      (if (= v false)
		  (throw (lambda (k)
			   (begin
			    (block k wrap)
			    ;; Yield to scheduler by enqueuing current continuation
			    ;; and returning control to C layer (parallel mode)
			    ;; or to schedule-loop (single-VM mode)
			    )))
		  (wrap v)))))
  )
