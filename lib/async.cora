;; Low-level async I/O API for Cora
;; This is the foundation for higher-level network APIs
;; Uses handle-map for GC-safe resource management
;; Uses CML perform mechanism for async operations

(package "cora/lib/async"
  (import "cora/lib/cml")
  (import "cora/lib/io")
  (import "cora/lib/string")
  (import "cora/lib/parallel/internal")
  (import "cora/lib/handle-map")

  (export
    async-listen async-dial
    async-recv async-send
    async-accept
    async-conn-close
    poller-init poller-shutdown)

  (def *async-sock-map* ())

  (defun async-sock-map-init ()
    (def *async-sock-map* (handle-map-create)))

  (defun ensure-async-sock-map ()
    (if (null? *async-sock-map*)
        (async-sock-map-init)
        ()))

  (defun async-sock-register (sock)
    (handle-map-add *async-sock-map* sock))

  ;; socket to connection object
  (define-record <async-sock>
    (async-sock-make-raw)
    false
    (fd async-sock-fd async-sock-fd-set!)
    (raw async-sock-raw async-sock-raw-set!)
    (event-handle async-sock-event-handle async-sock-event-handle-set!))

  (defun async-sock-create (fd)
    (begin
      (ensure-async-sock-map)
      (if (< fd 0)
          (error "async-sock-create invalid fd")
          (let raw (cora/lib/parallel/internal#async-socket-new fd)
            (if (= raw false)
                (error "async-sock-create failed")
                (let sock (async-sock-make-raw)
                  (begin
                    (async-sock-fd-set! sock fd)
                    (async-sock-raw-set! sock raw)
                    (let eh (cora/lib/parallel/internal#async-socket-get-event-handle raw)
                      (begin
                        (async-sock-event-handle-set! sock eh)
                        (async-sock-register sock)
                        sock)))))))))

  (defun poller-init ()
    (cora/lib/parallel/internal#poller-init))

  (defun poller-shutdown ()
    (cora/lib/parallel/internal#poller-shutdown))

  (defun poller-register-read (eh)
    (begin
      (cora/lib/parallel/internal#poller-remove-handle eh)
      (cora/lib/parallel/internal#event-handle-disable-all eh)
      (cora/lib/parallel/internal#event-handle-enable-read eh)
      (if (cora/lib/parallel/internal#poller-add-handle eh)
          true
          (error "poller-register-read failed"))))

  (defun poller-register-write (eh)
    (begin
      (cora/lib/parallel/internal#poller-remove-handle eh)
      (cora/lib/parallel/internal#event-handle-disable-all eh)
      (cora/lib/parallel/internal#event-handle-enable-write eh)
      (if (cora/lib/parallel/internal#poller-add-handle eh)
          true
          (error "poller-register-write failed"))))

  (defun poller-unregister (eh)
    (begin
      (cora/lib/parallel/internal#poller-remove-handle eh)
      (cora/lib/parallel/internal#event-handle-disable-all eh)))

  (defun register-wakeup (eh handle)
    (let self-vm (cora/lib/parallel/internal#vm-self)
      (if (= self-vm false)
          ()
          (cora/lib/parallel/internal#event-handle-set-wakeup-info eh self-vm handle)
          )))

  ;; Cora core does not provide a universal `error` symbol in every package.
  ;; Use CML-compatible throw to abort current coroutine safely on async failures.
  (defun error (msg)
    (throw (lambda (k)
             (begin
               (display "async error: ")
               (display msg)
               (display "\n")
               ()))))

  (defun default-wrap (x) x)

  (defun parse-addr (addr)
    (let parts (string-split addr ":")
      (if (= (length parts) 2)
          parts
          (error "invalid address"))))

  (defun async-recv-retry (sock buf k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/parallel/internal#async-socket-recv
              (async-sock-raw sock) buf)
        ['ok n]
        (begin
          (poller-unregister eh)
          (k (wrap n)))
        ['closed n]
        (begin
          (poller-unregister eh)
          (k (wrap 0)))
        ['block n]
        (begin
          (let handle (add-task-to-blocked (lambda (v) (async-recv-retry sock buf k wrap)))
            (begin
              (register-wakeup eh handle)
              (poller-register-read eh))))
        ['error e]
        (error "async-recv error"))))

  ;; recv on socket is an operation
  (defun async-recv-op (sock buf)
    (let try (lambda ()
               (match (cora/lib/parallel/internal#async-socket-recv
                       (async-sock-raw sock) buf)
                 ['ok n] n
                 ['block n] false
                 ['closed n] 0
                 ['error e] (error "async-recv error")))
         block (lambda (k wrap) (async-recv-retry sock buf k wrap))
         [try block default-wrap]))

  (defun async-recv (sock buf)
    (perform (async-recv-op sock buf)))

  (defun async-send-retry (sock buf k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/parallel/internal#async-socket-send
              (async-sock-raw sock) buf)
        ['ok n]
        (begin
          (poller-unregister eh)
          (k (wrap n)))
        ['block n]
        (begin
          (let handle (add-task-to-blocked (lambda (v) (async-send-retry sock buf k wrap)))
            (begin
              (register-wakeup eh handle)
              (poller-register-write eh))))
        ['closed n]
        (begin
          (poller-unregister eh)
          (error "async-send closed"))
        ['error e]
        (error "async-send error"))))

  ;; send on socket is an operation
  (defun async-send-op (sock buf)
    (let try (lambda ()
               (match (cora/lib/parallel/internal#async-socket-send
                       (async-sock-raw sock) buf)
                 ['ok n] n
                 ['block n] false
                 ['closed n] (error "async-send closed")
                 ['error e] (error "async-send error")))
         block (lambda (k wrap) (async-send-retry sock buf k wrap))
         [try block default-wrap]))

  (defun async-send (sock buf)
    (perform (async-send-op sock buf)))

  (defun async-accept-retry (listener k wrap)
    (let eh (async-sock-event-handle listener)
      (match (cora/lib/parallel/internal#async-socket-accept
              (async-sock-fd listener))
        ['ok fd]
        (begin
          (poller-unregister eh)
          (k (wrap (async-sock-create fd))))
        ['block]
        (begin
          (let handle (add-task-to-blocked (lambda (v) (async-accept-retry listener k wrap)))
            (begin
              (register-wakeup eh handle)
              (poller-register-read eh))))
        ['error e]
        (error "async-accept error"))))

  (defun async-accept-op (listener)
    (let try (lambda ()
               (match (cora/lib/parallel/internal#async-socket-accept
                       (async-sock-fd listener))
                 ['ok fd] (async-sock-create fd)
                 ['block] false
                 ['error e] (error "async-accept error")))
         block (lambda (k wrap) (async-accept-retry listener k wrap))
         [try block default-wrap]))

  (defun async-accept (listener)
    (perform (async-accept-op listener)))

  (defun async-connect-retry (sock k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/parallel/internal#async-socket-connect-check
              (async-sock-raw sock))
        ['ok]
        (begin
          (poller-unregister eh)
          (k (wrap sock)))
        ['block]
        (begin
          (let handle (add-task-to-blocked (lambda (v) (async-connect-retry sock k wrap)))
            (begin
              (register-wakeup eh handle)
              (poller-register-write eh))))
        ['error e]
        (begin
          (async-conn-close sock)
          (error "async-dial error")))))

  (defun async-dial-op (addr)
    (let parts (parse-addr addr)
      (let host (car parts)
           port (cadr parts)
        (let fd (cora/lib/parallel/internal#net-dial host port)
          (if (< fd 0)
              (error "async-dial failed")
              (let sock (async-sock-create fd)
                (let try (lambda ()
                           (match (cora/lib/parallel/internal#async-socket-connect-check
                                   (async-sock-raw sock))
                             ['ok] sock
                             ['block] false
                             ['error e] (begin
                                          (async-conn-close sock)
                                          (error "async-dial error"))))
                     block (lambda (k wrap) (async-connect-retry sock k wrap))
                     [try block default-wrap])))))))

  (defun async-dial (addr)
    (perform (async-dial-op addr)))

  (defun async-listen (addr)
    (let parts (parse-addr addr)
      (let host (car parts)
           port (cadr parts)
        (let fd (cora/lib/parallel/internal#net-listen host port)
          (async-sock-create fd)))))

  (defun async-conn-close (sock)
    (let eh (async-sock-event-handle sock)
      (begin
        (if (= eh false)
            ()
            (begin
              (cora/lib/parallel/internal#poller-remove-handle eh)
              (cora/lib/parallel/internal#event-handle-disable-all eh)))
        (cora/lib/parallel/internal#net-close (async-sock-fd sock)))))
  )
