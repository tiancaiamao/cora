;; Low-level async I/O API for Cora
;; This is the foundation for higher-level network APIs
;; Uses handle-map for GC-safe resource management
;; Uses CML perform mechanism for async operations

(package "cora/lib/async"
  (import "cora/lib/cml")
  (import "cora/lib/io")
  (import "cora/lib/parallel/internal")
  (import "cora/lib/parallel/handle-map")

  (export
    async-listen async-dial
    async-recv async-send
    async-accept
    async-conn-close
    poller-init poller-shutdown)

  (def *async-sock-map* ())

  (defun async-sock-map-init ()
    (def *async-sock-map* (handle-map-create)))

  (defun async-sock-register (sock)
    (handle-map-add *async-sock-map* sock))

  ;; socket to connection object
  (define-record <async-sock>
    (async-sock-make-raw)
    false
    (fd async-sock-fd)
    (event-handle async-sock-event-handle))

  (defun async-sock-create (fd)
    (let sock (async-sock-make-raw)
      (begin
        (async-sock-fd-set! sock fd)
        ;; event handle in C
        (let eh (cora/lib/parallel/internal#event-handle-new fd)
          (begin
            (async-sock-event-handle-set! sock eh)
            ;; register to handle-map to make resource protected from been GC
            (async-sock-register sock)
            sock)))))

  (defun poller-init ()
    (cora/lib/parallel/internal#poller-init))

  (defun poller-shutdown ()
    (cora/lib/parallel/internal#poller-shutdown))

  (defun recv-try (mailbox)
      (cora/lib/parallel/internal#mailbox-recv-try mailbox))

  (defun recv-block (mailbox k wrap)
      (let resume (lambda (v) (k (wrap v)))
            handle (add-task-to-blocked resume)
            vm (cora/lib/parallel/internal#vm-self)
            wakeup (cora/lib/parallel/internal#wakeup-create vm handle ())
            (cora/lib/parallel/internal#mailbox-recvq-enqueue mailbox wakeup)))

  (defun default-wrap (x) x)

  ;; recv on mailbox is an operation
  (defun async-recv-op (sock buf)
    (let try (lambda ()
              (match (cora/lib/parallel/internal#async-socket-recv
                      (async-sock-fd sock) buf 0)
                ['ok n] n
                ['block n] false
                ['error e] (error "async-recv error")))
         block (lambda (k wrap)
                 (let eh (async-sock-event-handle sock)
                   (begin
                     ;; register resume function to blocked-coroutine
                     (let handle (add-task-to-blocked
                                   (lambda (value)
                                     ;; retry when the event is ready again
                                     (wrap (cora/lib/parallel/internal#async-socket-recv
                                            (async-sock-fd sock) buf -1))))
                       (begin
                         ;; set the VM（for parallel mode）
                         ; (let self-vm (cora/lib/parallel/internal#vm-self)
                         ;   (if (not (null? self-vm))
                         ;       ;; 注意：这里需要 C 层提供设置 target_vm 的 API
                         ;       ;; 暂时注释掉，等后续实现
                         ;       ;; (cora/lib/parallel/internal#event-handle-set-target-vm! eh self-vm)
                         ;       ()))
                         ;; set connection to readable
                         (cora/lib/parallel/internal#event-handle-enable-read eh))))))
         [try block default-wrap]))

  (defun async-recv (sock buf)
    (perform (async-recv-op sock buf)))

  (defun send-try (sock val)
      (begin
          ;; try send first
          (if (cora/lib/parallel/internal#async-socket-send
                  (async-sock-fd sock) val)
              ()
              false)))

  (defun send-block (sock k val wrap)
      (let eh (async-sock-event-handle sock)
        (begin
          ;; register resume function
          (let handle (add-task-to-blocked
                (lambda (v)
                  (wrap (cora/lib/parallel/internal#async-socket-send
                         (async-sock-fd sock) val))))
            ; (begin
            ;   ;; 设置关联的 VM
            ;   (let self-vm (cora/lib/parallel/internal#vm-self)
            ;     (if (not (null? self-vm))
            ;         ;; (cora/lib/parallel/internal#event-handle-set-target-vm! eh self-vm)
            ;         ()))
              ;; set listening writable event on event handle
              (cora/lib/parallel/internal#event-handle-enable-write eh)))))

  ;; send on socket is an operation
  (defun async-send-op (sock val)
    (let try (lambda () (send-try sock val))
         block (lambda (k wrap) (send-block sock k val wrap))
         [try block default-wrap]))

  (defun async-send (sock val)
    (perform (async-send-op sock val)))


  ;; Accept 需要监听 socket 和新连接的 socket
  ;; 这是一个简化版本，完整实现需要更复杂的处理
  (defun async-accept (listener)
    ;; 简化实现：使用 C 层的 async-socket-accept
    ;; 这会在新连接可用时返回
    (perform
      (let try (lambda ()
                (cora/lib/parallel/internal#async-socket-accept listener))
           block (lambda (k wrap)
                   ;; 需要设置读事件监听
                   ;; 暂时简化处理
                   (cora/lib/parallel/internal#event-handle-enable-read
                     (cora/lib/parallel/internal#async-socket-get-event-handle listener)))
           [try block default-wrap])))

  (defun async-listen (addr)
    (let fd (cora/lib/parallel/internal#net-listen addr)
      (async-sock-create fd)))

  (defun async-dial (addr)
    (let fd (cora/lib/parallel/internal#net-dial addr)
      (async-sock-create fd)))

  (defun async-conn-close (sock)
    (cora/lib/parallel/internal#net-close (async-sock-fd sock)))
  )
