;; Low-level async I/O API for Cora
;; This is the foundation for higher-level network APIs.
;; API returns Result-style values:
;;   ['ok value] | ['err message]

(package "cora/lib/async"
  (import "cora/lib/cml")
  (import "cora/lib/io")
  (import "cora/lib/string")
  (import "cora/lib/net/internal")
  (import "cora/lib/poller/internal")
  (import "cora/lib/handle-map")

  (export
    async-listen async-dial
    async-recv async-send
    async-accept
    async-conn-close
    poller-init poller-shutdown)

  (def *async-sock-map* ())

  (defun async-ok (value)
    ['ok value])

  (defun async-err (msg)
    ['err msg])

  (defun async-sock-map-init ()
    (def *async-sock-map* (handle-map-create)))

  (defun ensure-async-sock-map ()
    (if (null? *async-sock-map*)
        (async-sock-map-init)
        ()))

  (defun async-sock-register (sock)
    (handle-map-add *async-sock-map* sock))

  ;; socket to connection object
  (define-record <async-sock>
    (async-sock-make-raw)
    false
    (fd async-sock-fd async-sock-fd-set!)
    (raw async-sock-raw async-sock-raw-set!)
    (event-handle async-sock-event-handle async-sock-event-handle-set!))

  (defun async-sock-create (fd)
    (begin
      (ensure-async-sock-map)
      (if (< fd 0)
          (async-err "async-sock-create invalid fd")
          (let raw (cora/lib/net/internal#async-socket-new fd)
            (if (= raw false)
                (async-err "async-sock-create failed")
                (let sock (async-sock-make-raw)
                  (begin
                    (async-sock-fd-set! sock fd)
                    (async-sock-raw-set! sock raw)
                    (let eh (cora/lib/net/internal#async-socket-get-event-handle raw)
                      (begin
                        (async-sock-event-handle-set! sock eh)
                        (async-sock-register sock)
                        (async-ok sock))))))))))

  (defun poller-init ()
    (cora/lib/poller/internal#poller-init))

  (defun poller-shutdown ()
    (cora/lib/poller/internal#poller-shutdown))

  (defun poller-register-read (eh)
    (begin
      (cora/lib/poller/internal#poller-remove-handle eh)
      (cora/lib/poller/internal#event-handle-disable-all eh)
      (cora/lib/poller/internal#event-handle-enable-read eh)
      (cora/lib/poller/internal#poller-add-handle eh)))

  (defun poller-register-write (eh)
    (begin
      (cora/lib/poller/internal#poller-remove-handle eh)
      (cora/lib/poller/internal#event-handle-disable-all eh)
      (cora/lib/poller/internal#event-handle-enable-write eh)
      (cora/lib/poller/internal#poller-add-handle eh)))

  (defun poller-unregister (eh)
    (begin
      (cora/lib/poller/internal#poller-remove-handle eh)
      (cora/lib/poller/internal#event-handle-disable-all eh)))

  (defun register-wakeup (eh handle)
    (cora/lib/poller/internal#event-handle-set-wakeup-info
      eh
      (cora/lib/poller/internal#vm-self)
      handle))

  (defun default-wrap (x) x)

  (defun parse-addr (addr)
    (if (has-prefix? addr ":")
        (async-ok (list "0.0.0.0" (string-slice addr 1 (string-length addr))))
        (let parts (string-split addr ":")
             len-parts (length parts)
             (cond
               ((= len-parts 2) (async-ok parts))
               ((= len-parts 1) (async-ok (cons "127.0.0.1" parts)))
               (true (async-err "invalid address"))))))

  (defun enqueue-blocked (retry-fn)
    (let handle (add-task-to-blocked retry-fn)
      (if (= handle -1)
          (async-err "blocked queue add failed")
          (async-ok handle))))

  (defun async-recv-retry (sock buf k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/net/internal#async-socket-recv
              (async-sock-raw sock) buf)
        ['ok n]
        (begin
          (poller-unregister eh)
          (k (wrap (async-ok n))))
        ['closed n]
        (begin
          (poller-unregister eh)
          (k (wrap (async-ok 0))))
        ['block n]
        (match (enqueue-blocked (lambda (v) (async-recv-retry sock buf k wrap)))
          ['err msg]
          (k (wrap (async-err msg)))
          ['ok handle]
          (if (register-wakeup eh handle)
              (if (poller-register-read eh)
                  ()
                  (begin
                    (poller-unregister eh)
                    (cancel-blocked-handle handle)
                    (k (wrap (async-err "poller-register-read failed")))))
              (begin
                (cancel-blocked-handle handle)
                (k (wrap (async-err "register-wakeup failed"))))))
        ['error e]
        (begin
          (poller-unregister eh)
          (k (wrap (async-err "async-recv error")))))))

  ;; recv on socket is an operation
  (defun async-recv-op (sock buf)
    (let try (lambda ()
               (match (cora/lib/net/internal#async-socket-recv
                       (async-sock-raw sock) buf)
                 ['ok n] (async-ok n)
                 ['block n] false
                 ['closed n] (async-ok 0)
                 ['error e] (async-err "async-recv error")))
         block (lambda (k wrap) (async-recv-retry sock buf k wrap))
         [try block default-wrap]))

  (defun async-recv (sock buf)
    (perform (async-recv-op sock buf)))

  (defun async-send-retry (sock buf k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/net/internal#async-socket-send
              (async-sock-raw sock) buf)
        ['ok n]
        (begin
          (poller-unregister eh)
          (k (wrap (async-ok n))))
        ['block n]
        (match (enqueue-blocked (lambda (v) (async-send-retry sock buf k wrap)))
          ['err msg]
          (k (wrap (async-err msg)))
          ['ok handle]
          (if (register-wakeup eh handle)
              (if (poller-register-write eh)
                  ()
                  (begin
                    (poller-unregister eh)
                    (cancel-blocked-handle handle)
                    (k (wrap (async-err "poller-register-write failed")))))
              (begin
                (cancel-blocked-handle handle)
                (k (wrap (async-err "register-wakeup failed"))))))
        ['closed n]
        (begin
          (poller-unregister eh)
          (k (wrap (async-err "async-send closed"))))
        ['error e]
        (begin
          (poller-unregister eh)
          (k (wrap (async-err "async-send error")))))))

  ;; send on socket is an operation
  (defun async-send-op (sock buf)
    (let try (lambda ()
               (match (cora/lib/net/internal#async-socket-send
                       (async-sock-raw sock) buf)
                 ['ok n] (async-ok n)
                 ['block n] false
                 ['closed n] (async-err "async-send closed")
                 ['error e] (async-err "async-send error")))
         block (lambda (k wrap) (async-send-retry sock buf k wrap))
         [try block default-wrap]))

  (defun async-send (sock buf)
    (perform (async-send-op sock buf)))

  (defun async-accept-retry (listener k wrap)
    (let eh (async-sock-event-handle listener)
      (match (cora/lib/net/internal#async-socket-accept
              (async-sock-fd listener))
        ['ok fd]
        (match (async-sock-create fd)
          ['ok sock]
          (begin
            (poller-unregister eh)
            (k (wrap (async-ok sock))))
          ['err msg]
          (begin
            (poller-unregister eh)
            (k (wrap (async-err msg)))))
        ['block]
        (match (enqueue-blocked (lambda (v) (async-accept-retry listener k wrap)))
          ['err msg]
          (k (wrap (async-err msg)))
          ['ok handle]
          (if (register-wakeup eh handle)
              (if (poller-register-read eh)
                  ()
                  (begin
                    (poller-unregister eh)
                    (cancel-blocked-handle handle)
                    (k (wrap (async-err "poller-register-read failed")))))
              (begin
                (cancel-blocked-handle handle)
                (k (wrap (async-err "register-wakeup failed"))))))
        ['error e]
        (k (wrap (async-err "async-accept error"))))))

  (defun async-accept-op (listener)
    (let try (lambda ()
               (match (cora/lib/net/internal#async-socket-accept
                       (async-sock-fd listener))
                 ['ok fd] (async-sock-create fd)
                 ['block] false
                 ['error e] (async-err "async-accept error")))
         block (lambda (k wrap) (async-accept-retry listener k wrap))
         [try block default-wrap]))

  (defun async-accept (listener)
    (perform (async-accept-op listener)))

  (defun async-connect-retry (sock k wrap)
    (let eh (async-sock-event-handle sock)
      (match (cora/lib/net/internal#async-socket-connect-check
              (async-sock-raw sock))
        ['ok]
        (begin
          (poller-unregister eh)
          (k (wrap (async-ok sock))))
        ['block]
        (match (enqueue-blocked (lambda (v) (async-connect-retry sock k wrap)))
          ['err msg]
          (k (wrap (async-err msg)))
          ['ok handle]
          (if (register-wakeup eh handle)
              (if (poller-register-write eh)
                  ()
                  (begin
                    (poller-unregister eh)
                    (cancel-blocked-handle handle)
                    (k (wrap (async-err "poller-register-write failed")))))
              (begin
                (cancel-blocked-handle handle)
                (k (wrap (async-err "register-wakeup failed"))))))
        ['error e]
        (begin
          (async-conn-close sock)
          (k (wrap (async-err "async-dial error")))))))

  (defun async-dial-op (addr)
    (match (parse-addr addr)
      ['err msg]
      (let try (lambda () (async-err msg))
           block (lambda (k wrap)
                   (k (wrap (async-err msg))))
           [try block default-wrap])
      ['ok parts]
      (let host (car parts)
           port (cadr parts)
        (let fd (cora/lib/net/internal#net-dial host port)
          (if (< fd 0)
              (let try (lambda () (async-err "async-dial failed"))
                   block (lambda (k wrap)
                           (k (wrap (async-err "async-dial failed"))))
                   [try block default-wrap])
              (match (async-sock-create fd)
                ['err msg]
                (let try (lambda () (async-err msg))
                     block (lambda (k wrap)
                             (k (wrap (async-err msg))))
                     [try block default-wrap])
                ['ok sock]
                (let try (lambda ()
                           (match (cora/lib/net/internal#async-socket-connect-check
                                   (async-sock-raw sock))
                             ['ok] (async-ok sock)
                             ['block] false
                             ['error e] (begin
                                          (async-conn-close sock)
                                          (async-err "async-dial error"))))
                     block (lambda (k wrap) (async-connect-retry sock k wrap))
                     [try block default-wrap])))))))

  (defun async-dial (addr)
    (perform (async-dial-op addr)))

  (defun async-listen (addr)
    (match (parse-addr addr)
      ['err msg]
      (async-err msg)
      ['ok parts]
      (let host (car parts)
           port (cadr parts)
        (let fd (cora/lib/net/internal#net-listen host port)
          (if (< fd 0)
              (async-err "async-listen failed")
              (async-sock-create fd))))))

  (defun async-conn-close (sock)
    (let eh (async-sock-event-handle sock)
      (begin
        (if (= eh false)
            ()
            (begin
              (cora/lib/poller/internal#poller-remove-handle eh)
              (cora/lib/poller/internal#event-handle-disable-all eh)))
        (cora/lib/net/internal#net-close (async-sock-fd sock))
        (async-ok true))))
  )
