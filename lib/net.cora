;; High-level synchronous-style network API
;; Internally uses async operations, but presents a synchronous interface
;; This is the user-facing API for network programming

(package "cora/lib/net"
  (import "cora/lib/infer")
  (import "cora/lib/cml")
  (import "cora/lib/string")
  (import "cora/lib/io")
  (import "cora/lib/async")

  (export
    net-listen net-dial
    net-accept
    net-recv net-send
    net-close
    make-bytes bytes-substring
    string->bytes bytes->string)

  ;; Type declarations live with module implementation.
  (declare 'net-listen
				  ['string '-> (tvar)])
  (declare 'cora/lib/net#net-listen
				  ['string '-> (tvar)])
  (declare 'net-dial
				  ['string '-> (tvar)])
  (declare 'cora/lib/net#net-dial
				  ['string '-> (tvar)])
  (declare 'net-accept
				  [(tvar) '-> (tvar)])
  (declare 'cora/lib/net#net-accept
				  [(tvar) '-> (tvar)])
  (declare 'net-recv
				  [(tvar) '-> ['int '-> (tvar)]])
  (declare 'cora/lib/net#net-recv
				  [(tvar) '-> ['int '-> (tvar)]])
  (declare 'net-send
				  [(tvar) '-> ['string '-> 'int]])
  (declare 'cora/lib/net#net-send
				  [(tvar) '-> ['string '-> 'int]])
  (declare 'net-close
				  [(tvar) '-> (tvar)])
  (declare 'cora/lib/net#net-close
				  [(tvar) '-> (tvar)])
  (declare 'make-bytes
			  `(int -> string))
  (declare 'cora/lib/net#make-bytes
			  `(int -> string))
  (declare 'bytes-substring
			  `(string -> (int -> (int -> string))))
  (declare 'cora/lib/net#bytes-substring
			  `(string -> (int -> (int -> string))))
  (declare 'string->bytes
			  `(string -> string))
  (declare 'cora/lib/net#string->bytes
			  `(string -> string))
  (declare 'bytes->string
			  `(string -> string))
  (declare 'cora/lib/net#bytes->string
			  `(string -> string))

  ;; Compatibility helpers used by existing network tests/code.
  (defun make-bytes (size)
    (bytes size))

  (defun bytes-substring (buf beg end)
    (string-slice buf beg end))

  (defun string->bytes (s)
    s)

  (defun bytes->string (b)
    b)

  (defun net-log-error (where msg)
    (begin
      (display "net error [")
      (display where)
      (display "]: ")
      (display msg)
      (display "\n")))

  (defun net-unwrap (where result fallback)
    (match result
      ['ok value] value
      ['err msg] (begin
                   (net-log-error where msg)
                   fallback)
      _ fallback))

  (defun net-listen (addr)
    (net-unwrap "net-listen" (cora/lib/async#async-listen addr) ()))

  (defun net-dial (addr)
    (net-unwrap "net-dial" (cora/lib/async#async-dial addr) ()))

  (defun net-accept (listener)
    (net-unwrap "net-accept" (cora/lib/async#async-accept listener) ()))

  (defun net-recv (conn size)
    (let buf (make-bytes size)
      (match (cora/lib/async#async-recv conn buf)
        ['ok n]
        (if (= n 0)
            ()
            (bytes-substring buf 0 n))
        ['err msg]
        (begin
          (net-log-error "net-recv" msg)
          ())
        _
        ())))

  (defun net-send (conn data)
    (match (cora/lib/async#async-send conn data)
      ['ok n] n
      ['err msg]
      (begin
        (net-log-error "net-send" msg)
        0)
      _
      0))

  (defun net-close (conn)
    (match (cora/lib/async#async-conn-close conn)
      ['ok _] ()
      ['err msg]
      (net-log-error "net-close" msg)
      _ ()))
    )
