(package "cora/lib/infer"
  (import "cora/lib/sys")
  (import "cora/lib/io")

  (export declare deftype check-type! tvar tc tc-mode)

  (defun append-tvar (l ret)
    (if (null? l)
	(reverse ret)
	(append-tvar (cdr l) (cons (cons 'tvar ()) (cons (car l) ret)))))

  (func replace-tvlist
	tvlist x => (if (elem? x tvlist) ['unquote x] x) where (symbol? x)
	tvlist () => ()
	tvlist [x . y] => [(replace-tvlist tvlist x) . (replace-tvlist tvlist y)])

  (defmacro forall (exp)
    (let tvlist (cadr exp)
      body (caddr exp)
      (cons 'let (append (append-tvar tvlist ()) [['backquote (replace-tvlist tvlist body)]]))))

  (def *tvar* 1000)
  (defun tvar ()
    (let ret *tvar*
      (do (def *tvar* (+ ret 1))
	  ret)))

  (def *type-env* ())
  (def *typecheck-mode* 'compat)
  (def *try-payload-stack* ())

  (defun declare (sym val)
    (def *type-env* (cons (cons sym val) *type-env*)))

  (defun tc-mode (mode)
    (if (or (= mode 'compat) (= mode 'strict))
	(def *typecheck-mode* mode)
	(cora/init#throw ['type-check-bad-mode mode])))

  ;; Visibility/name resolution is handled by resolver pass.
  ;; The type checker treats remaining untyped globals as dynamic.
  (defun resolve-unbound-symbol (sym t s)
    ['succ s])

  (defun push-try-payload (t)
    (def *try-payload-stack* (cons t *try-payload-stack*)))

  (defun pop-try-payload ()
    (if (null? *try-payload-stack*)
	()
	(def *try-payload-stack* (cdr *try-payload-stack*))))

  (defun current-try-payload ()
    (if (null? *try-payload-stack*)
	false
	(car *try-payload-stack*)))

  (set 'hd (car))
  (set 'tl (cdr))

  (defun unify (x y s)
    (unify1 (apply-subst x s) (apply-subst y s) s))

  (func bind-s
	['succ s] f => (f s)
	['fail . msg] f => ['fail . msg])

  (func unify1
	x y s => ['succ s] where (= x y)
	x y s => ['succ [[x . y] . s]] where (and (number? x) (not (occur? x y)))
	x y s => ['succ [[y . x] . s]] where (and (number? y) (not (occur? y x)))
	['-> a] ['-> b] s => (unify a b s)
	[a '-> b] [c '-> d] s => (bind-s (unify a c s)
					 (lambda (s1) (unify b d s1)))
	['list a] ['list b] s => (unify a b s) ;; TODO: list should be changed to elems in *type-rule*
	x y s => ['fail ['unify-mismatch x y]])

  (func occur?
	'int _ => false
	'bool _ => false
	'string _ => false
	'symbol _ => false
	[a '-> b] t => (or (occur? a t) (occur? b t))
	x [a '-> b] => (or (occur? x a) (occur? x b)) where (number? x)
	['list a] t => (occur? a t)
	v t => (= v t))

  (func apply-subst
	'int _ => 'int
	'bool _ => 'bool
	'symbol _ => 'symbol
	'string _ => 'string
	['-> t] s => ['-> (apply-subst t s)]
	[a '-> b] s => [(apply-subst a s) '-> (apply-subst b s)]
	['list a] s => ['list (apply-subst a s)]
	v s => (let find (assq v s)
		 (if (null? find)
		     v
		     (apply-subst (cdr find) s))))

  (defun extend (env v x)
    (cons (cons v x) env))

  ;; set need its special type check rule, because it involves the global
  ;; variable definition
  (defun check-type-for-set (s v env subst)
    (let find (assq s *type-env*)
      (if (null? find)
	  (let t (tvar)
	    (let res (check-type v t *type-env* ())
	      (bind-s res
		      (lambda (s1)
			(begin
			  (declare s (apply-subst t s1))
			  res)))))
	  (check-type v (cdr find) env subst))))

  (func check-type-h
	() t env s => ['succ s] where (number? t) ;; special check rule
	x t env s => (unify 'int t s) where (number? x)
	x t env s => (unify 'bool t s) where (boolean? x)
	x t env s => (unify 'string t s) where (string? x)
	['quote s] t env s => (unify 'symbol t s)
	x t env s => (let find (assq x env)
		       (if (null? find)
			   (let find1 (assq x *type-env*)
			     (if (null? find1)
				 (resolve-unbound-symbol x t s)
				 (unify (cdr find1) t s)))
			   (unify (cdr find) t s))) where (symbol? x)
	['throw v] t env s => (let payload (current-try-payload)
				   (if (= payload false)
				       (check-type v (tvar) env s)
				       (check-type v payload env s)))
	['try chunk handler] t env s => (let payload (tvar)
					     resume-arg (tvar)
					     (begin
					       (push-try-payload payload)
					       (let chunk-res (check-type chunk ['-> t] env s)
						 (begin
						   (pop-try-payload)
						   (bind-s chunk-res
							   (lambda (s1)
							     (check-type handler
									 [payload '-> [resume-arg '-> t]]
									 env s1)))))))
	['if e1 e2 e3] t env s => (bind-s (check-type-h e1 'bool env s)
							     (lambda (s1)
							       (bind-s (check-type e2 t env s1)
								       (lambda (s2)
									 (check-type e3 t env s2)))))
	['do e1 e2] t env s => (match (check-type-h e1 (tvar) env s)
				      ['succ s1] (check-type-h e2 t env s1)
				      ['fail] ['fail]
				      ['fail . msg] ['fail . msg])
	['do . args] t env s => ['fail ['do-arity args]]
	['lambda () e] any env s => (let a (tvar)
							 (bind-s (check-type e a env s)
								 (lambda (s1)
								   (unify any ['-> a] s1))))
	['lambda [x] e] any env s => (let tx (tvar)
							  te (tvar)
							  (bind-s (check-type e te (extend env x tx) s)
								  (lambda (s1)
								    (unify any [tx '-> te] s1))))
	['lambda [x . more] e] t env s => (check-type ['lambda [x] ['lambda more e]] t env s) where (not (= () more))
	['let a b c] t env s => (let tb (tvar)
						     (bind-s (check-type b tb env s)
							     (lambda (s1)
							       (check-type c t (extend env a tb) s1))))
	['set ['quote sym] v] t env s => (check-type-for-set sym v env s)
	[f] b env s => (check-type-h f ['-> b] env s)
	[f x] t env s => (let a (tvar) b (tvar)
						 (bind-s (check-type-h f [a '-> b] env s)
							 (lambda (s1)
							   (bind-s (check-type x (apply-subst a s1) env s1)
								   (lambda (s2)
								     (bind-s (unify t b s2)
									     (lambda (s3)
									       ['succ (filter (lambda (x)
												(let k (car x)
												  (not (or (= k a) (= k b)))))
											      s3)])))))))
	[f x . more] b env s => (check-type [[f x] . more] b env s)
	exp t env s => ['fail ['unsupported-form exp t]])

  (def *type-rule* ())
  (defun deftype (sym fn)
    (def *type-rule* (cons (cons sym fn) *type-rule*)))

  (defun check-type (exp typ env subst)
    (if (pair? typ)
	(let find (assq (car typ) *type-rule*)
	  (if (null? find)
	      (check-type-h exp typ env subst)
	      ((cdr find) exp typ env subst)))
	(check-type-h exp typ env subst)))

  (func type-check-for-list
	[] ['list a] env s => ['succ s]
	['cons x y] ['list a] env s => (bind-s (check-type x a env s)
					       (lambda (s1)
						 (check-type y ['list a] env s1)))
	exp typ env s => (check-type-h exp typ env s))

  (deftype 'list type-check-for-list)

  (func type-check-for-tuple
	['cons x y] ['tuple a b] env s => (bind-s (check-type x a env s)
						  (lambda (s1)
						    (check-type y b env s1))))
  (deftype 'tuple type-check-for-tuple)

  (func type-check-for-maybe
	[] ['maybe t] env s => ['succ s]
	exp ['maybe t] env s => (check-type exp t env s))
  (deftype 'maybe type-check-for-maybe)

  (func type-check-for-monad
	[retrn . x] ['monad a] env s => ['succ s]
	[bind ma f] ['monad a] env s => (bind-s (check-type ma ['monad a] env s)
						(lambda (s1)
						  (check-type f (let b (tvar) [a '-> ['monad b]]) env s1))))
  (deftype 'monad type-check-for-monad)

  (defun tc (on)
    (if on
	(def *typecheck* true)
	(def *typecheck* false)))

  (declare 'car (let a (tvar) b (tvar) [a '-> b]))
  (declare 'cons [(tvar) '-> [(tvar) '-> (tvar)]])
  (declare 'cdr [(tvar) '-> (tvar)])
  (declare 'hd (let a (tvar) [['list a] '-> a]))
  (declare 'tl (let a (tvar) [['list a] '-> ['list a]]))
  (declare '+ `(int -> (int -> int)))
  (declare '- `(int -> (int -> int)))
  (declare '* `(int -> (int -> int)))
  (declare '= (let a (tvar) b (tvar) `(,a -> (,b -> bool))))
  ;; (declare 'set (let a (tvar) ['symbol '-> [a '-> a]]))
  (declare 'null? [(tvar) '-> 'bool])
  (declare 'cons? [(tvar) '-> 'bool])
  (declare '*type-env* ['list ['tuple 'symbol (tvar)]])
  (declare 'error [(tvar) '-> (tvar)])
  (declare 'cora/init#throw [(tvar) '-> (tvar)])
  (declare 'import `(string -> ,(tvar)))

  (defun unwrap-fail-msg (msg)
    (if (and (pair? msg) (null? (cdr msg)))
	(car msg)
	msg))

  (defun explain-fail-msg (msg)
    (let payload (unwrap-fail-msg msg)
      (match payload
	['unify-mismatch expected actual]
	['type-mismatch "cannot unify expected type with actual type" expected actual]
	['unsupported-form exp typ]
	['unsupported-form "no checker rule matches expression form under expected type" exp typ]
	['do-arity args]
	['do-arity "do expects exactly 2 expressions; use begin for multiple" args]
	other
	['unknown-type-failure "type check failed without a specialized reason" other])))

  (defun declare-stdlib (sym fq typ)
    (begin
      (declare sym typ)
      (declare fq typ)))

  ;; io
  (declare-stdlib 'display 'cora/lib/io#display (let a (tvar) [a '-> a]))
  (declare-stdlib 'open-output-file 'cora/lib/io#open-output-file (let h (tvar) ['string '-> h]))
  (declare-stdlib 'close-output-file 'cora/lib/io#close-output-file (let h (tvar) [h '-> 'int]))
  (declare-stdlib 'read-all 'cora/lib/io#read-all (let h (tvar) [h '-> 'string]))
  (declare-stdlib 'copy 'cora/lib/io#copy (let h1 (tvar) h2 (tvar) [h1 '-> [h2 '-> 'bool]]))
  (declare-stdlib 'write-bytes 'cora/lib/io#write-bytes (let h (tvar) [h '-> ['string '-> 'int]]))

  ;; string
  (declare-stdlib 'string-slice 'cora/lib/string#string-slice `(string -> (int -> (int -> string))))
  (declare-stdlib 'has-prefix? 'cora/lib/string#has-prefix? `(string -> (string -> bool)))
  (declare-stdlib 'string-length 'cora/lib/string#string-length `(string -> int))
  (declare-stdlib 'string-index 'cora/lib/string#string-index `(string -> (int -> string)))
  (declare-stdlib 'compare 'cora/lib/string#compare `(string -> (string -> int)))
  (declare-stdlib 'number->string 'cora/lib/string#number->string `(int -> string))
  (declare-stdlib 'string-replace 'cora/lib/string#string-replace `(string -> (string -> (string -> string))))
  (declare-stdlib 'string-split 'cora/lib/string#string-split `(string -> (string -> (list string))))
  (declare-stdlib 'string-contain? 'cora/lib/string#string-contain? `(string -> (string -> bool)))
  (declare-stdlib 'byte-ref 'cora/lib/string#byte-ref `(string -> (int -> int)))
  (declare-stdlib 'string->list 'cora/lib/string#string->list `(string -> (list int)))
  (declare-stdlib 'string-join 'cora/lib/string#string-join `((list string) -> (string -> string)))
  (declare-stdlib 'string-trim 'cora/lib/string#string-trim `(string -> string))
  (declare-stdlib 'string-trim-left 'cora/lib/string#string-trim-left `(string -> string))
  (declare-stdlib 'string-trim-right 'cora/lib/string#string-trim-right `(string -> string))
  (declare-stdlib 'has-suffix? 'cora/lib/string#has-suffix? `(string -> (string -> bool)))
  (declare-stdlib 'string-upcase 'cora/lib/string#string-upcase `(string -> string))
  (declare-stdlib 'string-downcase 'cora/lib/string#string-downcase `(string -> string))
  (declare-stdlib 'memcpy 'cora/lib/string#memcpy `(string -> (int -> (string -> (int -> (int -> string))))))

  ;; hash/rand
  (declare-stdlib 'mod 'cora/lib/hash-h#mod `(int -> (int -> int)))
  (declare-stdlib 'hash-to-number 'cora/lib/hash-h#hash-to-number (let a (tvar) [a '-> 'int]))
  (declare-stdlib 'randN 'cora/lib/rand#randN `(int -> int))

  ;; os
  (declare-stdlib 'exec 'cora/lib/os#exec `((list string) -> int))
  (declare-stdlib 'popen 'cora/lib/os#popen (let h (tvar) [['list 'string] '-> ['symbol '-> h]]))
  (declare-stdlib 'pclose 'cora/lib/os#pclose (let h (tvar) [h '-> 'int]))
  (declare-stdlib 'file-exists? 'cora/lib/os#file-exists? `(string -> bool))
  (declare-stdlib 'file-is-directory? 'cora/lib/os#file-is-directory? `(string -> bool))
  (declare-stdlib 'file-read-all 'cora/lib/os#file-read-all `(string -> string))
  (declare-stdlib 'file-write-all 'cora/lib/os#file-write-all `(string -> (string -> int)))
  (declare-stdlib 'delete-file 'cora/lib/os#delete-file `(string -> int))
  (declare-stdlib 'create-directory 'cora/lib/os#create-directory `(string -> int))
  (declare-stdlib 'list-directory 'cora/lib/os#list-directory `(string -> (list string)))

  ;; json
  (declare-stdlib 'json-load-file 'cora/lib/json#json-load-file (let j (tvar) ['string '-> j]))
  (declare-stdlib 'json-typeof 'cora/lib/json#json-typeof (let j (tvar) [j '-> 'symbol]))
  (declare-stdlib 'json-is-array? 'cora/lib/json#json-is-array? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-is-object? 'cora/lib/json#json-is-object? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-is-integer? 'cora/lib/json#json-is-integer? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-integer-value 'cora/lib/json#json-integer-value (let j (tvar) [j '-> 'int]))
  (declare-stdlib 'json-is-real? 'cora/lib/json#json-is-real? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-is-string? 'cora/lib/json#json-is-string? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-string-value 'cora/lib/json#json-string-value (let j (tvar) [j '-> 'string]))
  (declare-stdlib 'json-is-null? 'cora/lib/json#json-is-null? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-is-true? 'cora/lib/json#json-is-true? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-is-false? 'cora/lib/json#json-is-false? (let j (tvar) [j '-> 'bool]))
  (declare-stdlib 'json-array-size 'cora/lib/json#json-array-size (let j (tvar) [j '-> 'int]))
  (declare-stdlib 'json-array-get 'cora/lib/json#json-array-get (let j (tvar) a (tvar) [j '-> ['int '-> a]]))
  (declare-stdlib 'json-object-size 'cora/lib/json#json-object-size (let j (tvar) [j '-> 'int]))
  (declare-stdlib 'json-object-get 'cora/lib/json#json-object-get (let j (tvar) a (tvar) [j '-> ['string '-> a]]))

  ;; cora-implemented stdlib modules (cml/chan/async/net) now declare
  ;; their own signatures locally, close to implementation source.

  (defun check-type! (exp typ)
    (match (check-type exp typ () ())
      ['succ s] ['succ s]
      ['fail] (cora/init#throw ['type-check-failed exp typ ['unknown-type-failure "type check failed" ()]])
      ['fail . msg] (cora/init#throw ['type-check-failed exp typ (explain-fail-msg msg)])))


