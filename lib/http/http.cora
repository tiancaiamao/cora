;; Complete HTTP server example
;; Usage: DYLD_LIBRARY_PATH=./src ./cora examples/http/hello-server.cora

(package "cora/lib/http"
  (import "cora/lib/http/internal")
  (import "cora/lib/net")
  (import "cora/lib/io")

  ;; ============================================================================
  ;; Request/Response Helpers
  ;; ============================================================================

  ;; Get field from request
  (defun http-request-get (req field)
    (cdr (assoc field req)))

  ;; Get header from request
  (defun http-request-get-header (req header-name)
    (let headers (http-request-get req 'headers))
    (cdr (assoc header-name headers)))

  ;; Create new response
  (defun http-response-new (status headers body)
    (list (cons 'status status)
          (cons 'headers headers)
          (cons 'body body)))

  ;; Create simple 200 OK response
  (defun http-response-ok (body)
    (http-response-new 200
                        (list (cons "Content-Type" "text/plain"))
                        body))

  ;; Create 404 Not Found response
  (defun http-response-not-found ()
    (http-response-new 404
                        (list (cons "Content-Type" "text/html"))
                        "<h1>404 Not Found</h1>"))

  ;; Create 500 Internal Server Error response
  (defun http-response-error (msg)
    (http-response-new 500
                        (list (cons "Content-Type" "text/plain"))
                        msg))

  ;; Create text/html response
  (defun http-response-html (html)
    (http-response-new 200
                        (list (cons "Content-Type" "text/html"))
                        html))

  ;; Create application/json response
  (defun http-response-json (json)
    (http-response-new 200
                        (list (cons "Content-Type" "application/json"))
                        json))

  ;; ============================================================================
  ;; HTTP Server (Go-style)
  ;; ============================================================================

  ;; Serve a single HTTP connection
  (defun http-serve-conn (conn handler)
    (let buf (make-bytes 4096)
      (let n (net-recv conn buf)
        (if (> n 0)
            (begin
              ;; Parse request
              (let req (http-internal-parse-request buf))
              (if req
                  ;; Call handler and send response
                  (begin
                    (let resp (handler req))
                    (let resp-bytes (http-internal-build-response resp))
                    (net-send conn resp-bytes))
                  ;; Parse failed - send 400
                  (begin
                    (let resp (http-response-new 400
                                                  (list (cons "Content-Type" "text/plain"))
                                                  "Bad Request"))
                    (let resp-bytes (http-internal-build-response resp))
                    (net-send conn resp-bytes))))
            ;; Connection closed
            (net-close conn)))))

  ;; Accept loop - accept connections and spawn handlers
  (defun http-accept-loop (listener handler)
    (let conn (net-accept listener)
      (begin
        ;; Spawn new thread to handle connection
        (spawn (lambda ()
                 (http-serve-conn conn handler)))
        ;; Continue accepting
        (http-accept-loop listener handler))))

  ;; Start HTTP server (Go-style: http.ListenAndServe)
  ;; Usage: (http-listen-and-serve ":8080" #'my-handler)
  (defun http-listen-and-serve (addr handler)
    (let listener (net-listen addr)
      (begin
        (display "HTTP server listening on ")
        (display addr)
        (newline)
        (http-accept-loop listener handler))))

  ;; ============================================================================
  ;; Simple Router (Optional)
  ;; ============================================================================

  ;; Create new serve mux (router)
  (defun http-new-serve-mux ()
    '())

  ;; Add handler to mux
  (defun http-handle (mux pattern handler)
    (cons (cons pattern handler) mux))

  ;; Find handler in mux
  (defun http-mux-find-handler (mux path)
    (if (null? mux)
        ;; No handler found - return 404 handler
        (lambda (req) (http-response-not-found))
        ;; Check first entry
        (let entry (car mux))
        (let pattern (car entry))
        (let handler (cdr entry))
        (if (equal? pattern path)
            handler
            ;; Try next
            (http-mux-find-handler (cdr mux) path))))

  ;; Handler that uses mux
  (defun http-mux-handler (mux)
    (lambda (req)
      (let path (http-request-get req 'path))
      (let handler (http-mux-find-handler mux path))
      (handler req)))
  )