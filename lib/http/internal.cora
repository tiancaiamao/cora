;; HTTP library internal bindings
;; Low-level C function bindings for HTTP parsing and building

(package "cora/lib/http/internal"

  (import "cora/internal")

  ;; C function: parse HTTP request
  ;; (http-internal-parse-request bytes) -> request-alist
  (defprim http-internal-parse-request 1)

  ;; C function: build HTTP response
  ;; (http-internal-build-response response-alist) -> bytes
  (defprim http-internal-build-response 1)
)