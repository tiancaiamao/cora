;; Backward-compatible shim.
;; Canonical module moved to cora/lib/net/http.

(package "cora/lib/http"
  (import "cora/lib/net/http")

  (export listen-and-serve http-listen-and-serve
          http-request-get http-request-get-header
          http-response-new http-response-ok http-response-not-found
          http-response-error http-response-html http-response-json
          http-new-serve-mux http-handle http-mux-handler)

  (defun listen-and-serve (addr handler)
    (cora/lib/net/http#listen-and-serve addr handler))

  (defun http-listen-and-serve (addr handler)
    (cora/lib/net/http#http-listen-and-serve addr handler))

  (defun http-request-get (req field)
    (cora/lib/net/http#http-request-get req field))

  (defun http-request-get-header (req header-name)
    (cora/lib/net/http#http-request-get-header req header-name))

  (defun http-response-new (status headers body)
    (cora/lib/net/http#http-response-new status headers body))

  (defun http-response-ok (body)
    (cora/lib/net/http#http-response-ok body))

  (defun http-response-not-found ()
    (cora/lib/net/http#http-response-not-found))

  (defun http-response-error (msg)
    (cora/lib/net/http#http-response-error msg))

  (defun http-response-html (html)
    (cora/lib/net/http#http-response-html html))

  (defun http-response-json (json)
    (cora/lib/net/http#http-response-json json))

  (defun http-new-serve-mux ()
    (cora/lib/net/http#http-new-serve-mux))

  (defun http-handle (mux pattern handler)
    (cora/lib/net/http#http-handle mux pattern handler))

  (defun http-mux-handler (mux)
    (cora/lib/net/http#http-mux-handler mux))
)
