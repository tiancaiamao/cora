(package "cora/example/ping-pong"
	 (import "cora/lib/cml")
	 (import "cora/lib/parallel/mailbox")
	 (import "cora/lib/io")

	 (let s2c (mailbox-make)
	      c2s (mailbox-make)

	      (begin

	       (defun server ()
		 (begin
		  (perform
		   ;; (choice
		   (wrap (mailbox-recv c2s) (lambda (v)
					   (begin
					    (display "server recv:")
					    (display v)
					    (display "\n"))))
		   ;; (wrap (mailbox-send s2c "pong") (lambda (v)
		   ;; 				   (display "server send pong\n")))
		   )
		  ;; )
		  (server)))

	       (defun client ()
		 (begin
		  (perform
		   ;; (choice
		   (wrap (mailbox-send c2s 1) (lambda (v)
						(display "client send ping\n")))
		   ;; (wrap (mailbox-recv s2c) (lambda (v) (begin
		   ;; 					(display "client recv:")
		   ;; 					(display v)
		   ;; 					(display "\n")
		   ;; 					v)))
		   ;; )
		   )
		  (client)))

	       (display "hello world\n")

	       (cml-entry (lambda ()
		       (begin
			(display "spawn server\n")
			(spawn server)
			(display "spawn client\n")
			(spawn client))))))
	 )
