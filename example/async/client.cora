(package "cora/example/async/client"

  (import "cora/lib/net")
  (import "cora/lib/io")
  (import "cora/lib/cml")

  (defun client-main ()
    (let conn (net-dial "127.0.0.1:8080")
      (begin
        (let resp (net-recv conn 11)
          (if (null? resp)
              (display "client recv failed\n")
              (begin
                (display resp)
                (display "\n"))))
        (net-send conn "hello arthur")
        (net-close conn))))

  (cml-entry client-main)
  )
