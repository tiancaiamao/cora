;; Hello World HTTP server
;; Usage: DYLD_LIBRARY_PATH=./src ./cora examples/http/hello-server.cora
;; Then: curl http://localhost:8080/

(import "cora/lib/http")

(defun hello-handler (req)
  (let path (http-request-get req 'path)
  (begin
    (display "Request: ")
    (display (http-request-get req 'method))
    (display " ")
    (display path)
    (newline)
    
    (http-response-html
      (string-append
        "<html><body>"
        "<h1>Hello from Cora!</h1>"
        "<p>You requested: " path "</p>"
        "<p>Method: " (http-request-get req 'method) "</p>"
        "</body></html>")))))

(display "Starting Hello World HTTP server on :8080\n")
(http-listen-and-serve ":8080" hello-handler)
